#!/bin/zsh

set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
readonly SCREENSTAMP_CONFIG_PATH="${SCREENSTAMP_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/screenstamp}"
readonly PROFILE_DIR="${SCREENSTAMP_PROFILE_DIR:-$SCREENSTAMP_CONFIG_PATH/profiles}"
readonly DISPLAYPLACER_BIN="${DISPLAYPLACER_BIN:-displayplacer}"
readonly APP_HELPER_BIN="${SCREENSTAMP_APP_HELPER_BIN:-}"
readonly PROFILE_HEADER="screenstamp-profile-v1"

die() {
  print -u2 -- "screenstamp: $*"
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  screenstamp save [--force] <name>
  screenstamp load <name>
  screenstamp save-displays [--force] <name>
  screenstamp load-displays <name>
  screenstamp save-apps [--force] <name>
  screenstamp load-apps <name>
  screenstamp permissions
  screenstamp list

Commands:
  save           Save display layout and window placements (both)
  load           Apply display layout and restore window placements (both)
  save-displays  Save only display layout
  load-displays  Apply only display layout without moving apps
  save-apps      Save only window placements
  load-apps      Restore only window placements
  permissions    Check or request macOS Accessibility permissions
  list           List saved profiles

Names may contain letters, numbers, dots, underscores, and hyphens.
EOF
}

validate_name() {
  local name="$1"

  if ! print -r -- "$name" | LC_ALL=C grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'; then
    die "invalid profile name '$name'"
  fi
}

require_displayplacer() {
  if [[ "$DISPLAYPLACER_BIN" == */* ]]; then
    [[ -x "$DISPLAYPLACER_BIN" ]] || die "displayplacer is not executable: $DISPLAYPLACER_BIN"
  elif ! command -v "$DISPLAYPLACER_BIN" >/dev/null 2>&1; then
    die "displayplacer was not found; install it with: brew install displayplacer"
  fi
}

get_app_helper() {
  if [[ -n "$APP_HELPER_BIN" ]]; then
    print -r -- "$APP_HELPER_BIN"
    return 0
  fi
  if [[ -x "$SCRIPT_DIR/screenstamp-app-helper" ]]; then
    print -r -- "$SCRIPT_DIR/screenstamp-app-helper"
    return 0
  fi
  if [[ -f "$SCRIPT_DIR/screenstamp-app-helper.swift" ]] && command -v swift >/dev/null 2>&1; then
    print -r -- "swift $SCRIPT_DIR/screenstamp-app-helper.swift"
    return 0
  fi
  return 1
}

check_permissions() {
  local helper
  helper="$(get_app_helper 2>/dev/null)" || die "screenstamp app helper is missing"
  eval "$helper permissions"
}

read_display_state() {
  require_displayplacer
  "$DISPLAYPLACER_BIN" list || die "could not read the connected displays"
}

# Convert displayplacer's human-readable blocks into portable role + options rows.
# A profile deliberately excludes physical screen IDs, which differ between desks.
state_to_profile_rows() {
  awk '
    function reset_screen() {
      role = ""
      resolution = ""
      hertz = ""
      depth = ""
      scaling = ""
      origin = ""
      rotation = ""
    }

    BEGIN { reset_screen() }

    /^Type: / {
      if ($0 == "Type: MacBook built in screen") {
        kind = "builtin"
      } else if ($0 ~ /external screen$/) {
        kind = "external"
      } else {
        kind = ""
      }

      if (kind != "") {
        count[kind]++
        role = kind "-" count[kind]
      }
      next
    }

    /^Resolution: / { resolution = $2; next }
    /^Hertz: / { hertz = $2; next }
    /^Color Depth: / { depth = $3; next }
    /^Scaling: / { scaling = $2; next }
    /^Origin: / { origin = $2; next }
    /^Rotation: / { rotation = $2; next }

    /^Enabled: / {
      enabled = $2
      if (role == "" || resolution == "" || depth == "" || scaling == "" ||
          origin == "" || rotation == "" || enabled == "") {
        next
      }

      options = "res:" resolution
      if (hertz != "" && hertz != "N/A") {
        options = options " hz:" hertz
      }
      options = options " color_depth:" depth
      options = options " enabled:" enabled
      options = options " scaling:" scaling
      options = options " origin:" origin
      options = options " degree:" rotation

      print role "\t" options
      reset_screen()
    }
  '
}

# Extract JSON of display geometries (origin, size) keyed by role.
state_to_displays_json() {
  awk '
    BEGIN { print "{" }
    /^Type: / {
      if ($0 == "Type: MacBook built in screen") {
        kind = "builtin"
      } else if ($0 ~ /external screen$/) {
        kind = "external"
      } else {
        kind = ""
      }
      if (kind != "") {
        count[kind]++
        role = kind "-" count[kind]
      }
      next
    }
    /^Resolution: / { res = $2; next }
    /^Origin: / { orig = $2; next }
    /^Enabled: / {
      if (role != "" && res != "" && orig != "") {
        split(res, r, "x")
        gsub(/[()]/, "", orig)
        split(orig, o, ",")
        if (sep) print ","
        printf "\"%s\":{\"x\":%s,\"y\":%s,\"w\":%s,\"h\":%s}", role, o[1], o[2], r[1], r[2]
        sep = 1
        role = ""; res = ""; orig = ""
      }
    }
    END { print "\n}" }
  '
}

# Extract the IDs for the displays connected at load time using the same roles.
state_to_current_ids() {
  awk '
    /^Persistent screen id: / { id = $4; next }

    /^Type: / {
      if ($0 == "Type: MacBook built in screen") {
        kind = "builtin"
      } else if ($0 ~ /external screen$/) {
        kind = "external"
      } else {
        kind = ""
      }

      if (kind != "" && id != "") {
        count[kind]++
        print kind "-" count[kind] "\t" id
      }
      id = ""
    }
  '
}

save_apps() {
  local name=""
  local force=0

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -*) die "unknown option '$1'" ;;
      *)
        if [[ -n "$name" ]]; then
          usage >&2; exit 2
        fi
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { usage >&2; exit 2; }
  validate_name "$name"
  helper="$(get_app_helper 2>/dev/null)" || die "screenstamp app helper is missing"
  state="$(read_display_state)"

  if [[ -r "$PROFILE_DIR/$name.profile" ]]; then
    local profile_displays current_displays
    profile_displays="$(awk -F'\t' '$1 ~ /^(builtin|external)-/ { count++ } END { print count+0 }' "$PROFILE_DIR/$name.profile")"
    current_displays="$(print -r -- "$state" | awk '
      /^Type: / {
        if ($0 == "Type: MacBook built in screen" || $0 ~ /external screen$/) count++
      }
      END { print count+0 }
    ')"
    if (( profile_displays > current_displays )) && (( ! force )); then
      die "profile '$name' expects $profile_displays display(s), but only $current_displays is connected. Refusing to overwrite app placements with collapsed single-display state. Pass --force to overwrite."
    fi
  fi

  mkdir -p -- "$PROFILE_DIR"
  displays_json_file="$(mktemp "${TMPDIR:-/tmp}/screenstamp-displays.XXXXXX")"
  print -r -- "$state" | state_to_displays_json > "$displays_json_file"
  eval "$helper save \"$displays_json_file\" \"$PROFILE_DIR/$name.apps\"" || die "could not save app placements"
  rm -f -- "$displays_json_file"
}

save_profile() {
  local name=""
  local force=0
  local save_apps_flag=1

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      --displays-only|--no-apps) save_apps_flag=0; shift ;;
      -*) die "unknown option '$1'" ;;
      *)
        if [[ -n "$name" ]]; then
          usage >&2; exit 2
        fi
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { usage >&2; exit 2; }
  validate_name "$name"
  state="$(read_display_state)"
  rows="$(print -r -- "$state" | state_to_profile_rows)"
  [[ -n "$rows" ]] || die "displayplacer returned no usable display configuration"

  local display_count
  display_count="$(print -r -- "$rows" | awk 'END { print NR }')"

  if [[ -r "$PROFILE_DIR/$name.profile" ]]; then
    local profile_displays
    profile_displays="$(awk -F'\t' '$1 ~ /^(builtin|external)-/ { count++ } END { print count+0 }' "$PROFILE_DIR/$name.profile")"
    if (( profile_displays > display_count )) && (( ! force )); then
      die "profile '$name' expects $profile_displays display(s), but only $display_count is connected. Refusing to overwrite profile with fewer displays. Pass --force to overwrite."
    fi
  fi

  mkdir -p -- "$PROFILE_DIR"
  destination="$PROFILE_DIR/$name.profile"
  temporary="$(mktemp "$PROFILE_DIR/.$name.XXXXXX")" || die "could not create a temporary profile"

  if ! {
    print -r -- "$PROFILE_HEADER"
    print -r -- "$rows"
  } > "$temporary"; then
    rm -f -- "$temporary"
    die "could not write profile '$name'"
  fi

  if ! mv -f -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    die "could not save profile '$name'"
  fi

  print -- "Saved '$name' with $display_count display(s)."

  if (( save_apps_flag )); then
    if helper="$(get_app_helper 2>/dev/null)"; then
      displays_json_file="$(mktemp "${TMPDIR:-/tmp}/screenstamp-displays.XXXXXX")"
      print -r -- "$state" | state_to_displays_json > "$displays_json_file"
      eval "$helper save \"$displays_json_file\" \"$PROFILE_DIR/$name.apps\"" || print -u2 -- "screenstamp: could not save app placements"
      rm -f -- "$displays_json_file"
    fi
  fi
}

load_apps() {
  local name=""

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -*) die "unknown option '$1'" ;;
      *)
        if [[ -n "$name" ]]; then
          usage >&2; exit 2
        fi
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { usage >&2; exit 2; }
  local apps_file="$PROFILE_DIR/$name.apps"
  local helper state displays_json_file

  validate_name "$name"
  [[ -r "$apps_file" ]] || die "apps profile for '$name' does not exist"

  helper="$(get_app_helper 2>/dev/null)" || die "screenstamp app helper is missing"
  state="$(read_display_state)"
  displays_json_file="$(mktemp "${TMPDIR:-/tmp}/screenstamp-displays.XXXXXX")"
  print -r -- "$state" | state_to_displays_json > "$displays_json_file"
  eval "$helper load \"$displays_json_file\" \"$apps_file\"" || die "could not restore app placements"
  rm -f -- "$displays_json_file"
}

load_profile() {
  local name=""
  local load_apps_flag=1

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --displays-only|--no-apps) load_apps_flag=0; shift ;;
      -*) die "unknown option '$1'" ;;
      *)
        if [[ -n "$name" ]]; then
          usage >&2; exit 2
        fi
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { usage >&2; exit 2; }
  local source header state current_rows role id options
  integer current_count=0
  integer profile_count=0
  typeset -A current_ids
  typeset -A profile_roles
  typeset -a arguments

  validate_name "$name"
  source="$PROFILE_DIR/$name.profile"
  [[ -r "$source" ]] || die "profile '$name' does not exist"

  IFS= read -r header < "$source" || die "profile '$name' is empty"
  [[ "$header" == "$PROFILE_HEADER" ]] || die "profile '$name' has an unsupported format"

  state="$(read_display_state)"
  current_rows="$(print -r -- "$state" | state_to_current_ids)"

  while IFS=$'\t' read -r role id; do
    [[ -n "$role" ]] || continue
    [[ -z "${current_ids[$role]-}" ]] || die "connected display role '$role' is duplicated"
    current_ids[$role]="$id"
    (( current_count += 1 ))
  done <<< "$current_rows"

  while IFS=$'\t' read -r role options; do
    [[ -n "$role" ]] || continue
    [[ "$role" == "$PROFILE_HEADER" ]] && continue
    [[ -n "$options" ]] || die "profile '$name' contains an invalid row for '$role'"
    [[ -z "${profile_roles[$role]-}" ]] || die "profile '$name' duplicates role '$role'"
    [[ -n "${current_ids[$role]-}" ]] || die "profile needs '$role', but it is not connected"

    profile_roles[$role]=1
    arguments+=("id:${current_ids[$role]} $options")
    (( profile_count += 1 ))
  done < "$source"

  [[ "$profile_count" -gt 0 ]] || die "profile '$name' contains no displays"
  if (( profile_count != current_count )); then
    die "profile has $profile_count display(s), but $current_count are connected"
  fi

  "$DISPLAYPLACER_BIN" "${arguments[@]}" || die "displayplacer could not apply profile '$name'"
  print -- "Loaded '$name' onto $profile_count connected display(s)."

  if (( load_apps_flag )) && [[ -r "$PROFILE_DIR/$name.apps" ]]; then
    load_apps "$name"
  fi
}

list_profiles() {
  local profile
  typeset -a profiles

  setopt local_options null_glob
  profiles=("$PROFILE_DIR"/*.profile)

  if (( ${#profiles[@]} == 0 )); then
    print -- "No profiles saved."
    return
  fi

  for profile in "${profiles[@]}"; do
    print -- "${profile:t:r}"
  done
}

main() {
  local command="${1:-}"

  case "$command" in
    save)
      shift
      save_profile "$@"
      ;;
    save-displays|save-screens)
      shift
      save_profile --displays-only "$@"
      ;;
    save-apps)
      shift
      save_apps "$@"
      ;;
    load)
      shift
      load_profile "$@"
      ;;
    load-displays|load-screens|displays)
      shift
      load_profile --displays-only "$@"
      ;;
    load-apps|apps)
      shift
      load_apps "$@"
      ;;
    permissions)
      [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
      check_permissions
      ;;
    list)
      [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
      list_profiles
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
