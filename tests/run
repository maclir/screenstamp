#!/bin/zsh

set -u

readonly TEST_DIR="${0:A:h}"
readonly PROJECT_DIR="${TEST_DIR:h}"
readonly COMMAND="$PROJECT_DIR/bin/screenstamp"
readonly MOCK="$TEST_DIR/mock-displayplacer"
readonly MOCK_BREW="$TEST_DIR/mock-brew"
readonly MOCK_HELPER="$TEST_DIR/mock-app-helper"
readonly FIXTURES="$TEST_DIR/fixtures"

integer passed=0
integer failed=0

pass() {
  (( passed += 1 ))
  print -- "ok - $1"
}

fail() {
  (( failed += 1 ))
  print -u2 -- "not ok - $1"
}

assert_files_equal() {
  local description="$1"
  local expected="$2"
  local actual="$3"

  if diff -u -- "$expected" "$actual"; then
    pass "$description"
  else
    fail "$description"
  fi
}

temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/screenstamp-tests.XXXXXX")" || exit 1
trap 'rm -rf -- "$temporary_root"' EXIT

profile_dir="$temporary_root/profiles"
mkdir -p -- "$profile_dir"

helper_save_capture="$temporary_root/helper-save.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  APP_HELPER_CAPTURE_FILE="$helper_save_capture" \
  "$COMMAND" save office > "$temporary_root/save.out" 2> "$temporary_root/save.err"; then
  pass "save accepts a displayplacer layout"
else
  fail "save accepts a displayplacer layout"
  /bin/cat -- "$temporary_root/save.err" >&2
fi

assert_files_equal \
  "save removes physical IDs and preserves display settings" \
  "$FIXTURES/expected-office.profile" \
  "$profile_dir/office.profile"

if [[ -f "$profile_dir/office.apps" ]] && grep -q '"app_name": "iTerm2"' "$profile_dir/office.apps"; then
  pass "save captures app placements alongside display settings"
else
  fail "save captures app placements alongside display settings"
fi

helper_save_apps_capture="$temporary_root/helper-save-apps.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  APP_HELPER_CAPTURE_FILE="$helper_save_apps_capture" \
  "$COMMAND" save-apps custom-apps > "$temporary_root/save-apps.out" 2> "$temporary_root/save-apps.err"; then
  if [[ -f "$profile_dir/custom-apps.apps" ]] && grep -q "^save " "$helper_save_apps_capture"; then
    pass "save-apps saves only app placements"
  else
    fail "save-apps saves only app placements"
  fi
else
  fail "save-apps saves only app placements"
  /bin/cat -- "$temporary_root/save-apps.err" >&2
fi

helper_save_displays_capture="$temporary_root/helper-save-displays.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  APP_HELPER_CAPTURE_FILE="$helper_save_displays_capture" \
  "$COMMAND" save-displays only-displays > "$temporary_root/save-displays.out" 2> "$temporary_root/save-displays.err"; then
  if [[ -f "$profile_dir/only-displays.profile" ]] && [[ ! -f "$profile_dir/only-displays.apps" ]] && [[ ! -f "$helper_save_displays_capture" ]]; then
    pass "save-displays saves only display layout without app placements"
    rm -f -- "$profile_dir/only-displays.profile"
  else
    fail "save-displays saves only display layout without app placements"
  fi
else
  fail "save-displays saves only display layout without app placements"
  /bin/cat -- "$temporary_root/save-displays.err" >&2
fi

single_monitor_list="$temporary_root/single-monitor-list.txt"
sed -n '1,12p' "$FIXTURES/reference-list.txt" > "$single_monitor_list"

if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$single_monitor_list" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  "$COMMAND" save-apps office > /dev/null 2>&1; then
  fail "save-apps rejects overwriting multi-display profile when fewer displays are connected"
else
  pass "save-apps rejects overwriting multi-display profile when fewer displays are connected"
fi

if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$single_monitor_list" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  "$COMMAND" save-apps --force office > /dev/null 2>&1; then
  pass "save-apps --force allows overwriting multi-display profile when fewer displays are connected"
else
  fail "save-apps --force allows overwriting multi-display profile when fewer displays are connected"
fi

capture="$temporary_root/load-arguments.txt"
helper_load_capture="$temporary_root/helper-load.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/different-monitor-list.txt" \
  DISPLAYPLACER_CAPTURE_FILE="$capture" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  APP_HELPER_CAPTURE_FILE="$helper_load_capture" \
  "$COMMAND" load office > "$temporary_root/load.out" 2> "$temporary_root/load.err"; then
  pass "load accepts different physical monitor IDs"
else
  fail "load accepts different physical monitor IDs"
  /bin/cat -- "$temporary_root/load.err" >&2
fi

assert_files_equal \
  "load applies the saved settings to the currently connected IDs" \
  "$FIXTURES/expected-load-arguments.txt" \
  "$capture"

if [[ -f "$helper_load_capture" ]] && grep -q "^load " "$helper_load_capture"; then
  pass "load invokes app placement helper"
else
  fail "load invokes app placement helper"
fi

helper_load_apps_capture="$temporary_root/helper-load-apps.txt"
load_apps_display_capture="$temporary_root/load-apps-display.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  DISPLAYPLACER_CAPTURE_FILE="$load_apps_display_capture" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  APP_HELPER_CAPTURE_FILE="$helper_load_apps_capture" \
  "$COMMAND" load-apps office > "$temporary_root/load-apps.out" 2> "$temporary_root/load-apps.err"; then
  if [[ ! -e "$load_apps_display_capture" ]] && grep -q "^load " "$helper_load_apps_capture"; then
    pass "load-apps restores app placements without calling displayplacer"
  else
    fail "load-apps restores app placements without calling displayplacer"
  fi
else
  fail "load-apps restores app placements without calling displayplacer"
  /bin/cat -- "$temporary_root/load-apps.err" >&2
fi

helper_load_displays_capture="$temporary_root/helper-load-displays.txt"
load_displays_capture="$temporary_root/load-displays-capture.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/different-monitor-list.txt" \
  DISPLAYPLACER_CAPTURE_FILE="$load_displays_capture" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  APP_HELPER_CAPTURE_FILE="$helper_load_displays_capture" \
  "$COMMAND" load-displays office > "$temporary_root/load-displays.out" 2> "$temporary_root/load-displays.err"; then
  if [[ -f "$load_displays_capture" ]] && [[ ! -e "$helper_load_displays_capture" ]]; then
    pass "load-displays applies display layout without moving apps"
  else
    fail "load-displays applies display layout without moving apps"
  fi
else
  fail "load-displays applies display layout without moving apps"
  /bin/cat -- "$temporary_root/load-displays.err" >&2
fi

if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  "$COMMAND" permissions > "$temporary_root/perms.out"; then
  if grep -q "Accessibility permissions: OK" "$temporary_root/perms.out"; then
    pass "permissions command queries accessibility status"
  else
    fail "permissions command queries accessibility status"
  fi
else
  fail "permissions command queries accessibility status"
fi

if SCREENSTAMP_PROFILE_DIR="$profile_dir" "$COMMAND" list > "$temporary_root/list.out"; then
  if [[ "$(<"$temporary_root/list.out")" == "office" ]]; then
    pass "list prints saved profile names"
  else
    fail "list prints saved profile names"
  fi
else
  fail "list prints saved profile names"
fi

if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  "$COMMAND" save '../unsafe' > /dev/null 2>&1; then
  fail "save rejects unsafe profile names"
else
  pass "save rejects unsafe profile names"
fi

mismatch_capture="$temporary_root/mismatch-arguments.txt"
if SCREENSTAMP_PROFILE_DIR="$profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/extra-monitor-list.txt" \
  DISPLAYPLACER_CAPTURE_FILE="$mismatch_capture" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  "$COMMAND" load office > /dev/null 2> "$temporary_root/mismatch.err"; then
  fail "load rejects a different number of connected displays"
else
  if [[ ! -e "$mismatch_capture" ]]; then
    pass "load rejects a different number of connected displays"
  else
    fail "load rejects before applying a mismatched layout"
  fi
fi

make_profile_dir="$temporary_root/make-profiles"
mkdir -p -- "$make_profile_dir"
if SCREENSTAMP_PROFILE_DIR="$make_profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  make -s -C "$PROJECT_DIR" save meeting-room > "$temporary_root/make.out" 2> "$temporary_root/make.err"; then
  if [[ -f "$make_profile_dir/meeting-room.profile" ]]; then
    pass "make save supports a positional profile name"
  else
    fail "make save supports a positional profile name"
  fi
else
  fail "make save supports a positional profile name"
  /bin/cat -- "$temporary_root/make.err" >&2
fi

if SCREENSTAMP_PROFILE_DIR="$make_profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  make -s -C "$PROJECT_DIR" save-apps meeting-room > "$temporary_root/make-save-apps.out" 2> "$temporary_root/make-save-apps.err"; then
  if [[ -f "$make_profile_dir/meeting-room.apps" ]]; then
    pass "make save-apps supports a positional profile name"
  else
    fail "make save-apps supports a positional profile name"
  fi
else
  fail "make save-apps supports a positional profile name"
  /bin/cat -- "$temporary_root/make-save-apps.err" >&2
fi

make_capture="$temporary_root/make-load-arguments.txt"
if SCREENSTAMP_PROFILE_DIR="$make_profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/different-monitor-list.txt" \
  DISPLAYPLACER_CAPTURE_FILE="$make_capture" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  make -s -C "$PROJECT_DIR" load meeting-room > "$temporary_root/make-load.out" 2> "$temporary_root/make-load.err"; then
  assert_files_equal \
    "make load supports a positional profile name" \
    "$FIXTURES/expected-load-arguments.txt" \
    "$make_capture"
else
  fail "make load supports a positional profile name"
  /bin/cat -- "$temporary_root/make-load.err" >&2
fi

if SCREENSTAMP_PROFILE_DIR="$make_profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  make -s -C "$PROJECT_DIR" save-displays meeting-room-displays > "$temporary_root/make-save-displays.out" 2> "$temporary_root/make-save-displays.err"; then
  if [[ -f "$make_profile_dir/meeting-room-displays.profile" ]] && [[ ! -f "$make_profile_dir/meeting-room-displays.apps" ]]; then
    pass "make save-displays supports a positional profile name"
  else
    fail "make save-displays supports a positional profile name"
  fi
else
  fail "make save-displays supports a positional profile name"
  /bin/cat -- "$temporary_root/make-save-displays.err" >&2
fi

if SCREENSTAMP_PROFILE_DIR="$make_profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/reference-list.txt" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  make -s -C "$PROJECT_DIR" load-apps meeting-room > "$temporary_root/make-apps.out" 2> "$temporary_root/make-apps.err"; then
  pass "make load-apps supports a positional profile name"
else
  fail "make load-apps supports a positional profile name"
  /bin/cat -- "$temporary_root/make-apps.err" >&2
fi

make_load_displays_capture="$temporary_root/make-load-displays-capture.txt"
if SCREENSTAMP_PROFILE_DIR="$make_profile_dir" \
  DISPLAYPLACER_BIN="$MOCK" \
  DISPLAYPLACER_LIST_FILE="$FIXTURES/different-monitor-list.txt" \
  DISPLAYPLACER_CAPTURE_FILE="$make_load_displays_capture" \
  SCREENSTAMP_APP_HELPER_BIN="$MOCK_HELPER" \
  make -s -C "$PROJECT_DIR" load-displays meeting-room > "$temporary_root/make-load-displays.out" 2> "$temporary_root/make-load-displays.err"; then
  assert_files_equal \
    "make load-displays supports a positional profile name" \
    "$FIXTURES/expected-load-arguments.txt" \
    "$make_load_displays_capture"
else
  fail "make load-displays supports a positional profile name"
  /bin/cat -- "$temporary_root/make-load-displays.err" >&2
fi

install_prefix="$temporary_root/install-prefix"
brew_capture="$temporary_root/brew-arguments.txt"
if BREW_CAPTURE_FILE="$brew_capture" \
  make -s -C "$PROJECT_DIR" install \
    PREFIX="$install_prefix" \
    DISPLAYPLACER=screenstamp-test-missing-displayplacer \
    BREW="$MOCK_BREW" \
    > "$temporary_root/install.out" 2> "$temporary_root/install.err"; then
  installed_command="$install_prefix/bin/screenstamp"
  if [[ -x "$installed_command" ]] && \
    [[ "$(<"$brew_capture")" == $'install\ndisplayplacer' ]] && \
    grep -Fqx '  screenstamp save office' "$temporary_root/install.out" && \
    grep -Fqx '  screenstamp load office' "$temporary_root/install.out" && \
    grep -Fqx '  screenstamp save-displays office' "$temporary_root/install.out" && \
    grep -Fqx '  screenstamp load-displays office' "$temporary_root/install.out" && \
    SCREENSTAMP_PROFILE_DIR="$profile_dir" "$installed_command" list > "$temporary_root/installed-list.out" && \
    [[ "$(<"$temporary_root/installed-list.out")" == "office" ]]; then
    pass "make install installs displayplacer and a working screenstamp command"
  else
    fail "make install installs displayplacer and a working screenstamp command"
  fi
else
  fail "make install installs displayplacer and a working screenstamp command"
  /bin/cat -- "$temporary_root/install.err" >&2
fi

script_install_dir="$temporary_root/script-install-bin"
script_brew_capture="$temporary_root/script-brew-arguments.txt"
if BREW_CAPTURE_FILE="$script_brew_capture" \
  SCREENSTAMP_INSTALL_DIR="$script_install_dir" \
  SCREENSTAMP_SOURCE_FILE="$COMMAND" \
  DISPLAYPLACER=screenstamp-test-missing-displayplacer \
  BREW="$MOCK_BREW" \
  /bin/sh "$PROJECT_DIR/install.sh" \
    > "$temporary_root/script-install.out" 2> "$temporary_root/script-install.err"; then
  script_installed_command="$script_install_dir/screenstamp"
  if [[ -x "$script_installed_command" ]] && \
    [[ "$(<"$script_brew_capture")" == $'install\ndisplayplacer' ]] && \
    grep -Fqx '  screenstamp save office' "$temporary_root/script-install.out" && \
    grep -Fqx '  screenstamp load office' "$temporary_root/script-install.out" && \
    grep -Fqx '  screenstamp save-displays office' "$temporary_root/script-install.out" && \
    grep -Fqx '  screenstamp load-displays office' "$temporary_root/script-install.out"; then
    pass "one-line installer installs displayplacer and screenstamp"
  else
    fail "one-line installer installs displayplacer and screenstamp"
  fi
else
  fail "one-line installer installs displayplacer and screenstamp"
  /bin/cat -- "$temporary_root/script-install.err" >&2
fi

print -- "$passed passed; $failed failed"
(( failed == 0 ))
